% ------------------------------------------------------------- declaration --
% RMIT Declaration and Statement of Authorship, required on the first page of
% the submission (see ../rubrics.md).
\newcommand{\drdeclaration}{%
  \section*{Declaration and Statement of Authorship}
  \addcontentsline{toc}{section}{Declaration and Statement of Authorship}
  \begin{enumerate}[leftmargin=1.7em]
    \item I/we have not impersonated, or allowed myself to be impersonated by,
      any person for the purposes of this assessment.
    \item This assessment is my/our original work and no part of it has been
      copied from any other source except where due acknowledgement is made.
    \item No part of this assessment has been written for me/us by any other
      person except where such collaboration has been authorised by the
      lecturer/teacher concerned.
    \item Where this work is being submitted for individual assessment, I
      declare that it is my original work and that no part has been contributed
      by, produced by or in conjunction with another student.
    \item I/we give permission for my assessment response to be reproduced,
      communicated, compared and archived for the purposes of detecting
      plagiarism.
    \item I/we give permission for a copy of my assessment to be retained by
      the university for review and comparison, including review by external
      examiners.
    \item I/we understand that:
      \begin{itemize}
        \item Plagiarism is the presentation of the work, idea or creation of
          another person as though it is your own. It is a form of cheating and
          is a very serious academic offence that may lead to exclusion from the
          University. Plagiarised material can be drawn from, and presented in,
          written, graphic and visual form, including electronic data and oral
          presentations. Plagiarism occurs when the origin of the material used
          is not appropriately cited.
        \item Plagiarism includes the act of assisting or allowing another
          person to plagiarise or to copy my work.
      \end{itemize}
  \end{enumerate}

  I/we agree and acknowledge that:

  \begin{enumerate}[leftmargin=1.7em]
    \item I/we have read and understood the Declaration and Statement of
      Authorship above.
    \item If I/we do not agree to the Declaration and Statement of Authorship in
      this context and a signature is not included below, the assessment outcome
      is not valid for assessment purposes and will not be included in my final
      result for this course.
  \end{enumerate}

  \vspace{0.15in}
  \begingroup
  \renewcommand{\dr@memberrow}[3]{##1 & ##2 & \rule{0pt}{2.2em}\hrulefill\\}%
  \begin{tabular}{@{}p{0.34\linewidth}p{0.18\linewidth}p{0.40\linewidth}@{}}
    \toprule
    \textbf{Name} & \textbf{Student ID} & \textbf{Signature}\\
    \midrule
    \dr@members
    \bottomrule
  \end{tabular}%
  \endgroup
  \clearpage
}

