% ------------------------------------------------------- figures and stubs --
% Real figure: \drfigure[width]{file}{caption}{label}
\NewDocumentCommand{\drfigure}{O{0.97\linewidth} m m m}{%
  \begin{figure}[H]
    \centering
    \includegraphics[width=#1,height=0.68\textheight,keepaspectratio]{#2}
    \caption{#3}
    \label{#4}
  \end{figure}%
}

% Placeholder that still produces a numbered, captioned, referenceable figure,
% so cross-references work before the artwork is drawn. Swap for \drfigure.
\NewDocumentCommand{\drfigurestub}{O{2.0in} m m}{%
  \begin{figure}[H]
    \centering
    \begingroup
    \setlength{\fboxsep}{12pt}%
    \fcolorbox{drline}{drpale}{%
      \parbox[c][#1][c]{\dimexpr0.9\linewidth-2\fboxsep-2\fboxrule\relax}{%
        \centering
        {\color{drred}\fontsize{9}{11}\selectfont\bfseries
          FIGURE PLACEHOLDER\par}
        \vspace{0.10in}
        {\color{drmuted}\fontsize{9.5}{12}\selectfont #2\par}
      }%
    }%
    \endgroup
    \caption{#2}
    \label{#3}
  \end{figure}%
}

% The brief asks for explanatory notes attached to diagrams. This renders one
% as a tinted block so no figure ships without its explanation.
% The argument is declared long (+m) so a note can run to more than one
% paragraph; without it, a blank line or \par inside a note is an error.
\NewDocumentCommand{\drnote}{+m}{%
  \par\noindent
  \begingroup
  \setlength{\fboxsep}{10pt}%
  \noindent
  \colorbox{drpale}{%
    \begin{minipage}{\dimexpr\linewidth-2\fboxsep\relax}
      {\color{drred}\fontsize{8}{10}\selectfont\bfseries NOTE\par}
      \vspace{0.04in}
      {\fontsize{9.5}{13}\selectfont #1\par}
    \end{minipage}%
  }%
  \endgroup
  \par\addvspace{8pt}
}

% Visible drafting marker. Search the PDF for "TODO" before submitting.
\NewDocumentCommand{\drtodo}{m}{%
  {\colorbox{drpaleamber}{\color{drred}\fontsize{9}{11}\selectfont\bfseries
    TODO}\enspace\color{drmuted}\textit{#1}}%
}

% ------------------------------------------------------------- key/value id --
% Short inline tag for a numbered design item, e.g. \drid{A7} or \drid{M03}.
\NewDocumentCommand{\drid}{m}{%
  {\ttfamily\bfseries\color{drnavy}#1}%
}

% ------------------------------------------------------------- long tables --
% Column fractions below are fractions of \dr@tw, the width actually available
% to text: \linewidth minus the inter-column gutters. Quoting them as fractions
% of \linewidth (the obvious thing) overruns the text block by the total gutter
% width and every row comes out overfull. Fractions in each table sum to 1.
\newlength{\dr@tw}
\newcommand{\dr@settw}[1]{%
  \setlength{\tabcolsep}{4pt}%
  \setlength{\dr@tw}{\dimexpr\linewidth-#1\tabcolsep\relax}%
}

% Assumptions register: \begin{drassumptions} ... rows ... \end{drassumptions}
% Row: \drid{A1} & assumption & justification & what it drives \\
% Each of the long tables below carries its own \caption. Without one, longtable
% still steps the table counter, so the numbered table silently disappears from
% the List of Tables and the numbering appears to skip.
\newenvironment{drassumptions}{%
  \footnotesize
  \dr@settw{6}%
  \begin{longtable}{@{}L{0.06\dr@tw}L{0.32\dr@tw}L{0.38\dr@tw}L{0.24\dr@tw}@{}}
    \caption{Assumptions register: each assumption, its justification, and the
      design element it determines}\\
    \toprule
    \textbf{ID} & \textbf{Assumption} & \textbf{Justification} &
      \textbf{Drives}\\
    \midrule
    \endfirsthead
    \toprule
    \textbf{ID} & \textbf{Assumption} & \textbf{Justification} &
      \textbf{Drives}\\
    \midrule
    \endhead
    \bottomrule
    \endlastfoot
}{%
  \end{longtable}\normalsize
}

% Message dictionary: one row per inter-task message.
% Row: \drid{M01} & name & mechanism & from $\to$ to & payload & timing \\
\newenvironment{drmessages}{%
  \footnotesize
  \dr@settw{10}%
  \begin{longtable}{@{}L{0.06\dr@tw}L{0.20\dr@tw}L{0.15\dr@tw}L{0.17\dr@tw}L{0.26\dr@tw}L{0.16\dr@tw}@{}}
    \caption{Message dictionary: every message exchanged between tasks}\\
    \toprule
    \textbf{ID} & \textbf{Message} & \textbf{Mechanism} & \textbf{From
      $\rightarrow$ To} & \textbf{Payload} & \textbf{Timing}\\
    \midrule
    \endfirsthead
    \toprule
    \textbf{ID} & \textbf{Message} & \textbf{Mechanism} & \textbf{From
      $\rightarrow$ To} & \textbf{Payload} & \textbf{Timing}\\
    \midrule
    \endhead
    \bottomrule
    \endlastfoot
}{%
  \end{longtable}\normalsize
}

% Task set for the schedulability analysis.
% Row: \drid{T1} & task & node & prio & policy & T & C & D \\
\newenvironment{drtaskset}{%
  \footnotesize
  \dr@settw{14}%
  \begin{longtable}{@{}L{0.055\dr@tw}L{0.20\dr@tw}L{0.115\dr@tw}L{0.11\dr@tw}L{0.19\dr@tw}L{0.11\dr@tw}L{0.11\dr@tw}L{0.11\dr@tw}@{}}
    \caption{Task set used for the schedulability analysis}\\
    \toprule
    \textbf{ID} & \textbf{Task} & \textbf{Node} & \textbf{Prio} &
      \textbf{Policy} & \textbf{$T$ (ms)} & \textbf{$C$ (ms)} &
      \textbf{$D$ (ms)}\\
    \midrule
    \endfirsthead
    \toprule
    \textbf{ID} & \textbf{Task} & \textbf{Node} & \textbf{Prio} &
      \textbf{Policy} & \textbf{$T$ (ms)} & \textbf{$C$ (ms)} &
      \textbf{$D$ (ms)}\\
    \midrule
    \endhead
    \bottomrule
    \endlastfoot
}{%
  \end{longtable}\normalsize
}

% Requirement -> design -> test traceability.
% Row: \drid{R1} & requirement & design element & test case \\
\newenvironment{drtrace}{%
  \footnotesize
  \dr@settw{6}%
  \begin{longtable}{@{}L{0.065\dr@tw}L{0.39\dr@tw}L{0.325\dr@tw}L{0.22\dr@tw}@{}}
    \caption{Traceability from requirement to design element to test}\\
    \toprule
    \textbf{ID} & \textbf{Requirement} & \textbf{Design element} &
      \textbf{Test}\\
    \midrule
    \endfirsthead
    \toprule
    \textbf{ID} & \textbf{Requirement} & \textbf{Design element} &
      \textbf{Test}\\
    \midrule
    \endhead
    \bottomrule
    \endlastfoot
}{%
  \end{longtable}\normalsize
}

% Generic full-width table body for anything else.
\newenvironment{drtable}[1]{%
  \footnotesize
  \begin{tabularx}{\linewidth}{#1}
    \toprule
}{%
    \bottomrule
  \end{tabularx}\normalsize
}

