% Arial is a wide face and the text block is narrow; without a little slack the
% justifier reports overfull lines it could otherwise absorb.
\setlength{\emergencystretch}{2em}

% Ragged-right paragraph column. Justifying 3--4 word cells in a 0.1\linewidth
% column is what produces every "Underfull \hbox (badness ...)" in the tables.
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}

% ---------------------------------------------------------------- headings --
\titleformat{\section}
  {\normalfont\bfseries\fontsize{19}{23}\selectfont\color{drnavy}}
  {\thesection.\hspace{0.55em}}{0pt}{}
\titlespacing*{\section}{0pt}{20pt}{12pt}

\titleformat{\subsection}
  {\normalfont\bfseries\fontsize{13}{16}\selectfont\color{drnavy}}
  {%
    \raisebox{-0.12em}{\color{drred}\rule{3pt}{1.05em}}%
    \hspace{0.65em}%
    \thesubsection%
  }{0.5em}{}
\titlespacing*{\subsection}{0pt}{16pt}{7pt}

% Add a full stop after top-level section numbers in the contents without
% changing figure, table, or subsection numbering.
\let\dr@original@sectionline\l@section
\renewcommand{\l@section}[2]{%
  \begingroup
  \let\dr@original@numberline\numberline
  \renewcommand{\numberline}[1]{\dr@original@numberline{##1.}}%
  \dr@original@sectionline{#1}{#2}%
  \endgroup
}

\titleformat{\subsubsection}
  {\normalfont\bfseries\fontsize{11}{14}\selectfont\color{drink}}
  {\thesubsubsection\hspace{0.5em}}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{13pt}{5pt}

% Per-section figure and table numbering, e.g. Figure 5.2 / Table 5.1.
\counterwithin{figure}{section}
\counterwithin{table}{section}

\captionsetup{
  font={sf,footnotesize},
  labelfont={bf,color=drred},
  labelsep=period,
  textfont={color=drink},
  justification=raggedright,
  singlelinecheck=false,
  skip=7pt
}

\setlist[itemize]{leftmargin=1.35em,topsep=3pt,itemsep=2pt,parsep=0pt}
\setlist[enumerate]{leftmargin=1.6em,topsep=3pt,itemsep=2pt,parsep=0pt}

