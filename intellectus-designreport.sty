\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{intellectus-designreport}[2026/08/10 v0.1 Group design report template]

% Companion to intellectus-labreport.sty, but for multi-author design documents:
% numbered sections, table of contents, numbered/captioned figures and tables,
% an assumptions register, a message dictionary, and figure stubs that carry a
% real caption and label before the artwork exists.

\RequirePackage{iftex}
% The template asks for 9.5pt in a few places (notes, figure stubs). Computer
% Modern only ships discrete sizes, so without this every note carrying inline
% maths or \ttfamily raises "font shape ... in size <9.5> not available".
\RequirePackage{anyfontsize}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage[utf8]{inputenc}
  \RequirePackage{lmodern}         % scalable Type1 text/mono at any size
  \RequirePackage[scaled=0.95]{helvet}
  \renewcommand{\familydefault}{\sfdefault}
\else
  \RequirePackage{fontspec}
  \defaultfontfeatures{Ligatures=TeX}
  \IfFontExistsTF{arial.ttf}{
    \setmainfont{arial}[
      Extension=.ttf,
      UprightFont=*,
      ItalicFont=*i,
      BoldFont=*bd,
      BoldItalicFont=*bi
    ]
    \setsansfont{arial}[
      Extension=.ttf,
      UprightFont=*,
      ItalicFont=*i,
      BoldFont=*bd,
      BoldItalicFont=*bi
    ]
  }{
    \setmainfont{texgyreheros}[
      Extension=.otf,
      UprightFont=*-regular,
      ItalicFont=*-italic,
      BoldFont=*-bold,
      BoldItalicFont=*-bolditalic
    ]
    \setsansfont{texgyreheros}[
      Extension=.otf,
      UprightFont=*-regular,
      ItalicFont=*-italic,
      BoldFont=*-bold,
      BoldItalicFont=*-bolditalic
    ]
  }
  % Without an explicit mono, \ttfamily falls back to bitmap cmtt and XeTeX
  % embeds generated .pk bitmaps in the PDF.
  \IfFontExistsTF{consola.ttf}{
    \setmonofont{consola}[
      Extension=.ttf,
      UprightFont=*,
      ItalicFont=*i,
      BoldFont=*b,
      BoldItalicFont=*z,
      Scale=MatchLowercase
    ]
  }{
    \setmonofont{texgyrecursor}[
      Extension=.otf,
      UprightFont=*-regular,
      ItalicFont=*-italic,
      BoldFont=*-bold,
      BoldItalicFont=*-bolditalic,
      Scale=MatchLowercase
    ]
  }
  \renewcommand{\familydefault}{\sfdefault}
\fi

